# Option B — thin overlay on the official image (DEPLOYED to CT 175 twenty-esc).
# Patches all 4 enterprise-validity methods so the enterprise gate is fully bypassed
# (backend SSO guard + frontend banner/Security-settings). Re-apply on upgrade by
# bumping the FROM tag and rebuilding. See patch-enterprise.cjs for the exact patch.
FROM twentycrm/twenty:v2.0.0
USER root
COPY patch-enterprise.cjs /tmp/patch-enterprise.cjs
RUN node /tmp/patch-enterprise.cjs && rm /tmp/patch-enterprise.cjs
