# ESC Tour — a FRONT-ONLY layer on an already-built ESC image.
#
# Why this shape rather than a source build of the whole monorepo:
#
#   The server binary in the base image is the one production is already running. Nothing
#   here recompiles it, so the Nest dependency-injection fault class that took the CRM down
#   for 16h41m on 2026-09-21 cannot be reintroduced by this image. The two compiled server
#   patches (enterprise bypass, SSRF allowlist) live in server files and are inherited from
#   the base, untouched — which is also why BASE_IMAGE must be an ESC image and never a bare
#   upstream tag. scripts/verify-esc-image.sh is the check that catches that mistake.
#
#   The frontend is plain static files served by NestJS ServeStaticModule from
#   dist/front. There is no asset manifest, no integrity check and no CSP pinning script
#   hashes, so replacing the whole directory as one unit is the entire operation.
#
# Build context must be a directory containing the built frontend at ./build — that is
# vite's outDir for twenty-front (packages/twenty-front/build). esc/deploy/build-front-layer.sh
# assembles it.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
# The whole directory is the unit: index.html and its hashed assets must move together, or
# the page asks for a bundle that is no longer there.
RUN rm -rf /app/packages/twenty-server/dist/front
COPY --chown=1000:1000 build /app/packages/twenty-server/dist/front
USER 1000
