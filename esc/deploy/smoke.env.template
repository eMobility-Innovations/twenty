# Environment for esc/deploy/boot-smoke-test.sh.
#
# WHY THIS FILE EXISTS, AND WHY IT IS NOT A COPY OF PRODUCTION'S ENV.
#
# A cutover on 2026-09-21 took esc.crm.fiszu.com down for 16h41m because a Nest
# module did not import PermissionsModule. Five green checks and a clean image
# said nothing about it: none of them boots a module graph. The smoke test does.
#
# The preflight critic's point was that a smoke run with a DIFFERENT env from
# production cannot catch the failure class that caused the outage — a DI fault on
# the SMTP path boots green under the default (logger) mail driver. What decides
# the provider graph is WHICH KEYS ARE SET, not what they contain. So this file
# carries production's exact key set with placeholder values for the secrets, and
# no credential is copied anywhere.
#
# The key set was read from the running production container on 2026-09-22:
#
#   pangolin ssh esc-blades-ct175.ssh -- \
#     'sudo docker inspect twenty-esc-server-1 \
#        --format "{{range .Config.Env}}{{println .}}{{end}}" | cut -d= -f1 | sort'
#
# Re-run that after any compose change and reconcile this file: boot-smoke-test.sh
# refuses to run if a key listed in ESC_SMOKE_REQUIRED_KEYS is missing here, but it
# cannot know about a key production gained and this file never heard of.
#
# NOTHING IN HERE IS A SECRET. PG_DATABASE_URL, REDIS_URL and APP_SECRET are
# overwritten by the script with throwaway values pointing at throwaway containers.

# --- overwritten by the script, never edit to point at anything real -----------
PG_DATABASE_URL=postgres://placeholder:placeholder@placeholder:5432/placeholder
REDIS_URL=redis://placeholder:6379
APP_SECRET=placeholder

# --- production's non-secret values, verbatim ---------------------------------
APP_VERSION=v2.0.0
NODE_PORT=3000
SERVER_URL=https://esc.crm.fiszu.com
REACT_APP_SERVER_BASE_URL=
STORAGE_TYPE=local
IS_BILLING_ENABLED=false
ENTERPRISE_KEY=self-hosted-esc

# The SSRF allowlist. Production's value is a host list; its CONTENT does not change
# the provider graph, only what the allowlist permits at call time.
ESC_SSRF_ALLOWED_HOSTS=192.168.103.175

# The four rate-limiting keys. Absent, the server builds a different throttler config.
API_RATE_LIMITING_SHORT_LIMIT=10000
API_RATE_LIMITING_SHORT_TTL_IN_MS=1000
API_RATE_LIMITING_LONG_LIMIT=100000
API_RATE_LIMITING_LONG_TTL_IN_MS=60000

# The mail path. EMAIL_DRIVER=smtp is the one that matters: it selects a different
# provider graph from the default logger driver, and that graph is exactly where a
# DI fault would boot green in a naive smoke run and kill production.
# The host is deliberately unroutable — nothing is sent, and DI does not connect.
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=smtp.invalid
EMAIL_SMTP_PORT=25
EMAIL_SMTP_NO_TLS=true
EMAIL_FROM_ADDRESS=smoke@invalid
EMAIL_FROM_NAME=ESC Boot Smoke Test
EMAIL_SYSTEM_ADDRESS=smoke@invalid
