# ── ruff, on the STAGED Python files only ────────────────────────────────────
#
# The org standard names ruff as the one Python linter/formatter, but nothing
# enforced it anywhere: measured 2026-08-04, mgr-cache and bl-cache had both
# accumulated `ruff check` errors and unformatted files on their trunks, and
# one of the check errors was an unused import introduced by a change that had
# already been reviewed, merged and DEPLOYED. Nobody was ignoring a red gate —
# there was no gate.
#
# STAGED FILES ONLY, never the whole tree. A repo carrying pre-existing lint
# debt must not block someone touching an unrelated file; that is how a gate
# becomes the thing everyone passes --no-verify to. You fix what you touch.
#
# Same fail-OPEN-but-LOUD discipline as the spec-drift block above: no ruff, no
# pyproject.toml, no Python staged -> say so and let the commit through. A gate
# that fails for reasons unrelated to what it checks is one people learn to
# bypass. `--force-exclude` is required when passing explicit paths, or ruff
# ignores the repo's own per-file excludes and flags generated/vendored code.
if [ -f "$ROOT/pyproject.toml" ]; then
  STAGED_PY="$(git diff --cached --name-only --diff-filter=ACM -z -- '*.py' 2>/dev/null | tr '\0' '\n' | sed '/^$/d')"
  if [ -n "$STAGED_PY" ]; then
    RUFF=""
    for c in "$ROOT/.venv/bin/ruff" "$ROOT/venv/bin/ruff" \
             "${MAIN_ROOT:-$ROOT}/.venv/bin/ruff" "${MAIN_ROOT:-$ROOT}/venv/bin/ruff"; do
      [ -x "$c" ] && { RUFF="$c"; break; }
    done
    [ -z "$RUFF" ] && command -v ruff >/dev/null 2>&1 && RUFF="ruff"
    if [ -z "$RUFF" ]; then
      echo "warning: ruff not found — LINT NOT CHECKED for this commit" >&2
    else
      RUFF_OUT=""
      if ! RUFF_OUT="$(printf '%s\n' "$STAGED_PY" | tr '\n' '\0' \
             | xargs -0 "$RUFF" check --force-exclude -- 2>&1)"; then
        printf '\nCOMMIT BLOCKED — ruff check failed on files you are committing.\n\n%s\n' \
          "$(printf '%s' "$RUFF_OUT" | tail -30)" >&2
        echo "Fix them, or auto-fix what is mechanical:  ruff check --fix <paths>" >&2
        echo "Only the files you STAGED are checked — this is not someone else's debt." >&2
        exit 1
      fi
      if ! RUFF_OUT="$(printf '%s\n' "$STAGED_PY" | tr '\n' '\0' \
             | xargs -0 "$RUFF" format --check --force-exclude -- 2>&1)"; then
        printf '\nCOMMIT BLOCKED — ruff format would rewrite files you are committing.\n\n%s\n' \
          "$(printf '%s' "$RUFF_OUT" | tail -30)" >&2
        echo "Run:  ruff format <paths>   then re-stage." >&2
        exit 1
      fi
    fi
  fi
fi

# --- credential residue: never let a REAL secret into a TRACKED file ------------------
#
# 2026-08-11: `mattermost-channel-manager/.env.example` was git-tracked, not gitignored,
# 0644 on the running host, and held the LIVE MM_BOT_TOKEN and the LIVE fiszu/admin-cli
# client secret. It survived every review because NOBODY DIFFS AN EXAMPLE FILE — the whole
# point of the file is to be full of fake secrets, which is what makes it the best hiding
# place for a real one. Both values are permanently in git history now.
#
# Same distribution and same inert-when-absent discipline as the OpenAPI block above:
# Actions is off for this org, so a CI-only gate would be decoration, and a gate that fails
# for reasons unrelated to what it checks is a gate people learn to bypass.
SECRET_GUARD="$(_policy_bin tracked-secret-guard.py)"
if [ -z "$HOME_DIR" ] || [ "$HAVE_PY3" -eq 0 ] || [ ! -f "$SECRET_GUARD" ]; then
  # Named at length on purpose. "SKIPPED: tracked-secret gate" scrolls past; what it
  # is FOR does not.
  guard_unreachable "tracked-secret gate — the one that refuses a REAL credential" \
                    "not found at $SECRET_GUARD"
elif ! python3 "$SECRET_GUARD" --check "$ROOT"; then
  echo "Do not bypass with --no-verify — a committed secret cannot be un-committed." >&2
  exit 1
fi

# ── NO COMMIT CARRIES A HALF-FINISHED MERGE ──────────────────────────────────
#
# 2026-08-25: THREE org trunks were found carrying live conflict blocks, the oldest
# for five days, every one of them landed through a GREEN gate. The worst was
# `internal-knowledge-base`'s shared BOARD — the file sessions read to decide what is
# claimed, done or open. It answered that question twice, in both directions, and was
# noticed only when somebody hit a rebase conflict against the markers themselves.
#
# STAGED, NOT THE TREE. You are refused for what YOU are committing. A repo that
# already carries a marker elsewhere is not held hostage over a file you never
# touched — that is a gate everybody learns to bypass, which this file refuses to be.
# `--all` is the audit sweep for the rest.
#
# Swept over 173 repos and 75,824 tracked text files before it was armed: four hits,
# all real conflicts, zero false positives.
CONFLICT_GUARD="$(_policy_bin tracked-conflict-marker-guard.py)"
if [ -z "$HOME_DIR" ] || [ "$HAVE_PY3" -eq 0 ] || [ ! -f "$CONFLICT_GUARD" ]; then
  guard_unreachable "conflict-marker gate — the one that refuses a half-finished merge" \
                    "not found at $CONFLICT_GUARD"
elif ! python3 "$CONFLICT_GUARD" --check "$ROOT"; then
  echo "Do not bypass with --no-verify — both sides are still in the file, and that is" >&2
  echo "the only moment at which that is true." >&2
  exit 1
fi

# ── the assertion-pipe-inversion gate — WARN ONLY, deliberately ──────────────────────
# Sibling of policies/pipeline-status.py: that one refuses a MASKED exit status read as
# success, this one refuses a status REPLACED by an innocent bystander's death.
#
#     printf '%s' "$out" | grep -q PATTERN        # in a file that sets pipefail
#
# `grep -q` exits on the match and closes the pipe; the writer dies of SIGPIPE and
# pipefail makes THAT the pipeline's verdict, so a MATCH reads as a MISS. Measured
# 2026-08-31: 99.8% inversion once the payload passes the 64 KiB pipe buffer, across
# 186 sites in 9 repos. The SHAPE is lethal under `set -e` (reproduced in isolation at
# rc 141, the next statement never running), but NO file in this repo pairs it with `-e`:
# here the harm is a WRONG BRANCH, not an abort. Read severity off the file, not the shape.
#
# ⚠️ WHY IT DOES NOT BLOCK YET. Arming it before the estate is swept refuses commits in
# every unswept repo AT ONCE — a different outage from the one it prevents. It warns,
# loudly, and names the fix. Arm it deliberately, per repo or estate-wide, with
# CLAUDE_ASSERTION_PIPE_GUARD=enforce; the guard then exits 1 here and this block blocks
# with no further edit. That is an operator decision, not this file's.
#
# ARMING IS PER REPO, in policy/assertion-pipe-armed.json — not a bare env var. The
# decision taken 2026-08-31 was to arm FOUR repos and deliberately spare a fifth, which
# no environment variable can express. CLAUDE_ASSERTION_PIPE_GUARD=enforce still forces
# it on for one shell.
PIPEINV_GUARD="$(_policy_bin assertion-pipe-inversion-guard.py)"
if [ -z "$HOME_DIR" ] || [ "$HAVE_PY3" -eq 0 ] || [ ! -f "$PIPEINV_GUARD" ]; then
  guard_unreachable "assertion-pipe-inversion gate — the one that catches an assertion that reports the WRITER's death" \
                    "not found at $PIPEINV_GUARD"
else
  #: rc 2 IS NOT rc 1. The guard exits 2 when it could not READ what it needed — a tree
  #: that tracks nothing, an unreadable arming manifest — and calling that a refusal would
  #: blame the change for a fault in the machine. It is counted as a gate that DID NOT RUN,
  #: which is the channel that exists for exactly this.
  python3 "$PIPEINV_GUARD" --check "$ROOT"
  PIPEINV_RC=$?
  if [ "$PIPEINV_RC" -eq 2 ]; then
    guard_unreachable "assertion-pipe-inversion gate — the one that catches an assertion that reports the WRITER's death" \
                      "it could not read what it needed — see the CANNOT RUN line above"
  elif [ "$PIPEINV_RC" -ne 0 ]; then
    echo "That gate is ARMED for this repo — see the ARMED line above." >&2
    exit 1
  fi
fi

if [ "$UNREACHABLE_GUARDS" -gt 0 ]; then
  cat >&2 <<MSG

  ⚠ $UNREACHABLE_GUARDS org gate(s) did NOT run for this commit — see the SKIPPED lines above.

    The commit is ALLOWED. These gates are inert when unreachable by design, because a
    gate that fails for reasons unrelated to what it checks is one everybody learns to
    bypass. But this commit has NOT been checked for a tracked credential or an
    alert-contract bypass, and that is a fact about this MACHINE, not about this change.

    Both copies were tried: the INSTALLED runtime (\$HOME/.claude/policy-runtime) first,
    then the developer checkout (\$HOME/Projects/claude-code-policy). Neither carries them.

    Re-arm them: clone eMobility-Innovations/claude-code-policy and run its ./install.sh,
                 which is what populates the runtime copy. If the checkout IS already
                 there, it is PARKED or STALE rather than missing -- the gates that ship
                 later than its branch simply do not exist in it. Check with:
                   python3 \$HOME/.claude/policy-runtime/bin/workstation-converge.py --check
MSG
fi


# ---------------------------------------------------------------------------
# 🔴 NOTHING BELOW THIS LINE MAY INHERIT THIS COMMIT'S GIT LOCATION.
#
# Everything a repo appends BELOW this point runs here — in practice its own test
# suite. Git exports GIT_DIR and GIT_INDEX_FILE into every hook and they override
# both `cwd` and `git -C`, so a suite whose fixtures build throwaway repositories
# has every git command redirected at THIS repository and at the TEMPORARY INDEX
# git built for the commit in flight. The suite resets that index to HEAD; git
# then writes a tree identical to HEAD's, records NOTHING, and reports success.
#
# MEASURED three times, none of them caught by a rail:
#   * keycloak-security-monitor 2026-08-19 (its #62, where this exact placement
#     was first proven): three commits in a row plus a fourth carrying an
#     unrelated new file, all created EMPTY. `git diff --cached` showed 13 staged
#     insertions while `git diff-tree HEAD` showed nothing. PR #61 merged one of
#     them, said it fixed the org gates block, and left it broken on main.
#   * whatsapp-supplier-manager 2026-08-20 (claude-gate-run's `_GIT_HOOK_ENV`):
#     four consecutive commits, both rails green, no files at all.
#   * github-access-manager 2026-08-20: PR #57 reached trunk as `cf84e7f` with
#     zero files and was DEPLOYED that way.
#
# WHY IT LOOKED RANDOM, measured and pinned by
# tests/test_precommit_template_scrub_order.py: git hands a hook a GIT_INDEX_FILE
# that is RELATIVE for a plain commit (`.git/index`) and ABSOLUTE for a PATHSPEC
# one (`/abs/.../next-index-N.lock`). A child running `git -C <fixture>` resolves
# the relative form against the fixture and touches nothing; it cannot escape the
# absolute one. So a suite run from here is dangerous exactly when the commit used
# `git commit -- <paths>` — the form org discipline REQUIRES in a shared checkout,
# and the form every commit that came out empty had used.
#
# pre-push has carried this unset since the 2026-08-13 internal-knowledge-base
# incident. It was never swept here, which is the worse of the two places: pre-push
# runs after the commit exists, this runs while git holds the index about to become
# it. Counted 2026-08-20: 174 local checkouts run a suite from a pre-commit hook
# with no scrub, against 90 that scrub.
#
# 🔴 ORDER IS THE DESIGN, AND IT IS THE WHOLE OF THE DESIGN. This sits BELOW every
# gate above, which MUST keep GIT_INDEX_FILE: the ruff gate finds its work with
# `git diff --cached`, and for a pathspec commit the set being committed exists
# ONLY in that temporary index. Scrubbing any earlier makes those gates inspect the
# wrong tree and pass a commit they never looked at — trading a silent corruption
# for a silent non-check.
#
# ── GATE: bash32-set-u-lint ──────────────────────────────────────────────────────────────────
# Flags a NEWLY-STAGED bash shape that aborts under `set -u` on bash < 4.4 and is harmless on
# 5.x — so production (Debian, bash 5.2) never sees it and only a workstation does.
#
#   1. `for x in "${arr[@]}"` — on bash < 4.4 an EMPTY array counts as UNSET under `set -u`.
#      Fix: `for x in ${arr[@]+"${arr[@]}"}`.
#      A `[[ -n "${input}" ]]` guard upstream does NOT make it safe. MEASURED 2026-08-30 on
#      /bin/bash 3.2.57: an input of a bare newline passes `-n` and still leaves `read -ra` with
#      ZERO elements, because `read` consumes the newline as its line terminator.
#   2. `local a="$1" b="...${a}..."` — `local` marks EVERY name on the line before expanding any
#      right-hand side, so `b`'s RHS reads the OUTER `a`, unbound under `set -u`.
#      Fix: two statements. `local a="$1" b; b="...${a}..."` is already correct.
#
# Both shapes exit **127** on /bin/bash 3.2.57, measured rather than assumed.
#
# WHY IT IS AN ORG GATE. The class is a property of the bash a script is RUN under, not of the
# repo it lives in, so a per-repo hook could only ever cover the repo that thought to add one.
# It was found and fixed FOUR times in `proxmox-automations` before anything looked for the
# class, and a sweep of 178 estate repos on 2026-08-30 — each tree read from `origin/main`, not
# from a checkout — found it in 23 more. It bites in AGENT shells specifically: a login zsh on
# macOS resolves `bash` to Homebrew 5.3 because /opt/homebrew/bin leads PATH, while an agent
# shell's PATH does not carry that entry and `#!/usr/bin/env bash` gets /bin/bash 3.2.57.
#
# WHY THE PREDICATE IS NARROW. Its first version found 49 sites in one repo, 31 in production
# scripts, and triage against ground truth made ALL 31 false positives. A later version was 37%
# false on a quoted array literal. A detector that fires on nearly every candidate is a defect
# report about its predicate, not a class to sweep — see bin/bash32-set-u-lint.awk, which
# documents each narrowing and what it costs.
#
# SCOPED TO THE LINES THIS COMMIT ADDS. The predicate needs the WHOLE file (it has to know how
# an array is filled before it can judge a use of it), so it runs over the working tree and its
# findings are intersected with the staged added lines. Pre-existing sites stay silent: a check
# that reports a 65-site backlog on every unrelated commit in every repo is one everybody learns
# to skip, and this one lands in 16+ repos at once.
#
# ── ESCALATION ───────────────────────────────────────────────────────────────────────────────
# WARN-ONLY, and it does NOT touch this script's exit status. The true-positive rate on NEW code
# has not been observed yet — the rates above are on code already written. To make it BLOCKING
# once it has, flip the single constant below from 0 to 1.
BASH32_SET_U_LINT_BLOCKING=0

B32_AWK="$(_policy_bin bash32-set-u-lint.awk)"
STAGED_SH="$(git diff --cached --name-only --diff-filter=ACM -z -- '*.sh' 2>/dev/null \
             | tr '\0' '\n' | sed '/^$/d')"
_b32_hits=0

if [ -n "$STAGED_SH" ] && [ ! -f "$B32_AWK" ]; then
  # ANNOUNCED, but only when there is shell in the commit. An absent gate that says nothing is
  # indistinguishable from one that passed — but a repo staging no shell has nothing for this
  # gate to check, and saying so on every Python commit in 16 repos is how a notice becomes
  # wallpaper.
  guard_unreachable "bash32-set-u lint" "not found at $B32_AWK"
elif [ -n "$STAGED_SH" ]; then
  while IFS= read -r _b32_f; do
    [ -z "$_b32_f" ] && continue
    [ -f "$_b32_f" ] || continue     # renamed-away, or not a regular file in the working tree
    # Only a script that actually enables `set -u` can be bitten by either shape.
    grep -qE '^[[:space:]]*set[[:space:]]+-[a-z]*u' "$_b32_f" 2>/dev/null || continue

    # New-file line numbers of every line this commit ADDS, from the staged diff with zero
    # context so each hunk header gives the exact starting line of the added run beneath it.
    _b32_added="$(git diff --cached --unified=0 -- "$_b32_f" 2>/dev/null | awk '
      /^\+\+\+/ { next }
      /^@@ /       { h = $0; sub(/^.*\+/, "", h); sub(/ .*$/, "", h)
                     split(h, a, ","); ln = a[1] + 0; next }
      /^\+/       { print ln; ln++ }
    ')"
    [ -n "$_b32_added" ] || continue

    while IFS= read -r _b32_hit; do
      [ -z "$_b32_hit" ] && continue
      _b32_line="$(printf '%s\n' "$_b32_hit" | cut -d: -f2)"
      grep -qx "$_b32_line" <<<"$_b32_added" || continue
      _b32_shape="$(printf '%s\n' "$_b32_hit" | cut -d: -f3)"
      _b32_name="$(printf '%s\n' "$_b32_hit" | cut -d: -f4)"
      if [ "$_b32_shape" = "unguarded-array-expansion" ]; then
        echo "[bash32-set-u-lint] WARN: ${_b32_f}:${_b32_line}: \`for x in \"\${${_b32_name}[@]}\"\` — on bash < 4.4 an EMPTY array is UNSET under set -u." >&2
        echo "  \`${_b32_name}\` is filled from a source that can yield zero elements and nothing tests \${#${_b32_name}[@]} first." >&2
        echo "  prefer:  for x in \${${_b32_name}[@]+\"\${${_b32_name}[@]}\"}; do" >&2
      else
        echo "[bash32-set-u-lint] WARN: ${_b32_f}:${_b32_line}: a later name on this \`local\` reads \`${_b32_name}\`, declared on the same line." >&2
        echo "  \`local\` marks every name before expanding any RHS, so that read is unbound under set -u on bash < 4.4." >&2
        echo "  prefer:  local ${_b32_name}=...; local other=\"...\${${_b32_name}}...\"      (two statements)" >&2
      fi
      echo "  measured on /bin/bash 3.2.57 (macOS): both shapes abort with rc=127. An AGENT shell gets that bash; your login shell does not." >&2
      _b32_hits=$((_b32_hits + 1))
    done <<B32EOF
$(awk -v path="$_b32_f" -f "$B32_AWK" PASS=1 "$_b32_f" PASS=2 "$_b32_f" 2>/dev/null)
B32EOF
  done <<B32FILES
$STAGED_SH
B32FILES
fi

if [ "$_b32_hits" -gt 0 ]; then
  echo "[bash32-set-u-lint] ${_b32_hits} new site(s) found. WARN-ONLY — commit proceeds." >&2
  if [ "$BASH32_SET_U_LINT_BLOCKING" = "1" ]; then
    exit 1
  fi
fi

# NO-OP WHEN THIS FILE IS RUN AS A SUBPROCESS, and that is not an oversight: a
# child cannot unset a variable in its parent. It is load-bearing only where these
# lines are part of the HOOK FILE ITSELF — the generated `templates/githooks-pre-commit`
# and the appended `templates/foreign-hook-org-gates-block.sh`, which is why the
