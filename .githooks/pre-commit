#!/usr/bin/env bash
# .githooks/pre-commit — the API standard, enforced where it can actually stop a
# mistake: locally, before the commit exists.
#
# GitHub Actions is not usable in this org (no workflow has ever run in any repo
# here), so a CI-only gate would be decoration. This needs no network and no
# Actions minutes.
#
# Arm it once per clone — core.hooksPath is local git config and cannot ship in
# the repo. Put this line in the repo's install.sh AND update.sh:
#
#     git config core.hooksPath .githooks
#
# Inert rather than failing when the checker is absent: a gate that fails for
# reasons unrelated to what it checks is a gate people learn to bypass.

# 🔴 IS THIS COMMIT EVEN THE TREE THE GATES BELOW ARE ABOUT TO CERTIFY?
#
# `git commit -- <paths>`, `git commit <paths>`, `git commit -a` and
# `git commit -i <paths>` do NOT commit `.git/index`. Git builds a SEPARATE temporary
# index for them and points this hook's GIT_INDEX_FILE at it. Everything this hook runs
# AFTER the scrub at the bottom — in practice this repo's own suite, and any
# `claude-gate-run` behind it — can then only see `.git/index`, a tree nobody is
# committing, and returns a verdict about it in the same words it uses for a real one.
#
# MEASURED 2026-08-30 on claude-code-policy (internal-knowledge-base
# findings/2026-08-30_a-partial-commit-is-gated-against-a-tree-it-will-not-create.md):
# an anchor deleted in the working tree only and committed with `git commit -- <path>`
# made the mutation rung find nothing staged, fall back to `HEAD~1..HEAD`, and print
# `PASS` about the PREVIOUS commit's guards.
#
# WHY IT IS HERE, IN THE HEADER, AND NOT IN THE GATE BODY BELOW. The body of this file
# is GENERATED from `bin/org-precommit-gates.sh`, which every repo with a hook of its
# own also invokes as a subprocess — so a line added there arms every one of those repos
# too. Operator decision 2026-08-30: arm the repos whose hook is DERIVED from this
# template, which are the ones that append a suite BELOW the scrub, and NOT the foreign
# callers, whose org gates run ABOVE the scrub and therefore already read the in-flight
# index correctly. This header is the only part of the generated template that is not
# shared with the runner, so it is the only place that decision can be expressed.
# `tests/test_commit_scope.py` pins BOTH halves — that it is here, and that it is not
# there.
#
# Costs one `basename` when there is nothing to say: the check returns before running
# git at all for every ordinary commit, every `--amend` and every `--allow-empty`.
#
# Runtime FIRST, developer checkout SECOND — same resolution as the org gates below, and
# for the same reason: a checkout can be parked on a branch where the file does not
# exist. Inert-but-LOUD when neither carries it; an absent gate that says nothing is
# indistinguishable from one that passed.
_COMMIT_SCOPE="${CLAUDE_POLICY_RUNTIME:-${HOME:-}/.claude/policy-runtime}/bin/policies/commit-scope.py"
[ -f "$_COMMIT_SCOPE" ] || _COMMIT_SCOPE="${HOME:-}/Projects/claude-code-policy/bin/policies/commit-scope.py"
if [ -f "$_COMMIT_SCOPE" ]; then
  python3 "$_COMMIT_SCOPE" --precommit || exit 1
else
  echo "  ⚠ SKIPPED: the commit-scope gate — whether this commit is the tree the gates" >&2
  echo "    below will certify. Not found at: $_COMMIT_SCOPE" >&2
  echo "    The commit is ALLOWED, and that is a fact about this MACHINE, not this change." >&2
fi
set -uo pipefail

# HOME is NOT guaranteed. A commit made by a systemd service has no HOME, and
# `set -u` turned a bare $HOME into a hard failure — so this gate, which is
# designed to be inert when the checker is missing, instead blocked a compliant
# repo with "HOME: unbound variable". That took out litellm-key-manager's panel
# on 2026-07-28: it commits registry.toml as a daemon, and every key issue died
# at the commit.
#
# Fall back to the invoking user's home from passwd before giving up, so the
# gate still RUNS for service accounts instead of silently skipping.
HOME_DIR="${HOME:-}"
if [ -z "$HOME_DIR" ]; then
  HOME_DIR="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# ── A GATE THAT CANNOT RUN MUST SAY SO ───────────────────────────────────────
#
# INERT-WHEN-ABSENT STAYS. Failing the commit instead would block every commit on
# every machine with no claude-code-policy checkout, and a gate everyone has to
# bypass is a defect in the gate — this file's own rule, three times over.
#
# INERT AND SILENT ARE DIFFERENT THINGS, and the difference was the bug. Until
# 2026-08-17 the four lines this replaces read:
#
#     [ -n "$HOME_DIR" ] || exit 0
#     command -v python3 >/dev/null 2>&1 || exit 0
#     [ -f "$GUARD" ] || exit 0
#
# Each `exit 0` ended the WHOLE HOOK, not the one check that could not run. So a
# machine without the sibling checkout lost the openapi gate, the alert-contract
# gate, ruff AND the tracked-secret gate — the last of which is what refuses a
# commit carrying a REAL credential — and lost them without printing one character.
#
# MEASURED, both directions, on a throwaway repo with a live-looking MM_BOT_TOKEN
# in a tracked .env.example:
#
#   HOME with no claude-code-policy  ->  commit LANDS, exit 0, ZERO output
#   HOME with it                     ->  COMMIT BLOCKED, the value named, exit 1
#
# The guard was never broken. It was unreachable, and the unreachability was
# unspeakable. On the workstation that writes this file both paths exist, which is
# precisely why nobody noticed.
#
# So now: each check that cannot run reports itself and is skipped ALONE; the rest
# of the hook still runs; and the commit ends with a count of what did not happen.
UNREACHABLE_GUARDS=0
guard_unreachable() {                 # $1 = which gate, $2 = why, or where we looked
  UNREACHABLE_GUARDS=$((UNREACHABLE_GUARDS + 1))
  echo "  ⚠ SKIPPED: $1 — $2" >&2
}

HAVE_PY3=1
command -v python3 >/dev/null 2>&1 || HAVE_PY3=0

# WHICH COPY OF THE POLICY CODE DOES THIS GATE RUN?
#
# It used to be exactly one path: $HOME/Projects/claude-code-policy -- a DEVELOPER
# WORKING CHECKOUT, which is mutable by design. Measured on the workstation that
# maintains this file, 2026-08-19: that checkout was parked on a topic branch 112
# commits behind trunk with 21 uncommitted files, so bin/org-precommit-gates.sh --
# which landed on trunk later -- did not exist there at all. Every commit on that
# machine announced "SKIPPED ... Not found at:" and landed having run NONE of the
# openapi gate, the alert-contract gate, ruff, or the tracked-secret gate.
#
# ~/.claude/policy-runtime is the INSTALLED copy: on main, clean, fast-forwarded by
# workstation-converge. Every other hook and the statusline on that machine had
# already been moved onto it; these gates were the straggler.
#
# Runtime FIRST, checkout SECOND, per SCRIPT rather than per root -- a root that
# happens to exist is not the same as one that carries the guard being asked for.
# When neither has it the checkout path is returned unchanged, so the existing
# inert-but-loud message keeps naming a path a human recognises.
_policy_bin() {
  _pb_rt="${CLAUDE_POLICY_RUNTIME:-$HOME_DIR/.claude/policy-runtime}/bin/$1"
  _pb_co="$HOME_DIR/Projects/claude-code-policy/bin/$1"
  if [ -f "$_pb_rt" ]; then printf '%s' "$_pb_rt"; else printf '%s' "$_pb_co"; fi
}

GUARD="$(_policy_bin openapi-guard.py)"
if [ -z "$HOME_DIR" ]; then
  guard_unreachable "openapi gate" "no HOME could be resolved for this commit"
elif [ "$HAVE_PY3" -eq 0 ]; then
  guard_unreachable "openapi gate" "python3 is not on PATH"
elif [ ! -f "$GUARD" ]; then
  guard_unreachable "openapi gate" "not found at $GUARD"
else
  # A LEG'S ERROR IS NOT ITS VERDICT, AND THE MESSAGE IS WHERE THE TWO GET CONFUSED.
  #
  # `openapi-guard.py` already distinguishes them: it reserves exit 2 for "I crashed"
  # (its own `except Exception` writes `openapi-guard: <exc>` and exits 2 under --check),
  # and it fails closed on purpose, because an evaluator that crashed has proven nothing.
  # This shell threw that distinction away — every non-zero code arrived at ONE message,
  # which tells the committer their repo is not OpenAPI-compliant and sends them to run a
  # migration skill. For a crash that verdict is invented, the advice is wrong, and a repo
  # that is already compliant gets migrated on the strength of it.
  #
  # Both still BLOCK. What changes is whether the reader debugs their API or this gate.
  python3 "$GUARD" --check "$ROOT"; OPENAPI_RC=$?
  if [ "$OPENAPI_RC" -eq 2 ]; then
    cat >&2 <<MSG

COMMIT BLOCKED — the OpenAPI guard ITSELF crashed. It reached no verdict.

This says nothing about this repo's API — the checker did not finish, so there is
no finding above to act on. The error it printed is the thing to look at, and it
belongs to claude-code-policy, not to this commit:

  $GUARD --check $ROOT

Do not bypass: a guard that cannot run is not permission to skip it.
MSG
    exit 1
  elif [ "$OPENAPI_RC" -ne 0 ]; then
    cat >&2 <<'MSG'

COMMIT BLOCKED — this repo serves an HTTP API that is not OpenAPI-compliant.

Do not bypass with --no-verify. Run the `api-openapi-migrate` skill, or:
  internal-knowledge-base/runbooks/openapi-v2-migration.md

Genuinely not an API? Add .openapi-policy.toml with waived=true, a reason and an
owner. A waiver with nobody's name on it is not a waiver.
MSG
    exit 1
  fi
fi

# The committed spec must match what the code generates. A spec that drifts is
# worse than no spec: it is confidently wrong, and every client believes it.
#
# INTERPRETER, and why this is not just `python3`: on macOS `python3` is the
# 3.9 system build, which cannot import a modern app (StrEnum, tomllib, `X | Y`
# annotations). The first version of this hook ran `if python3 gen…; then`, so
# on every Mac the import failed, the branch was skipped, and the hook reported
# a clean pass while checking NOTHING. Prefer the repo's own venv.
#
# The VERSIONED names are in this list for the same reason. Without them the only
# candidates were two venv paths and a bare `python3`, so a Mac with Homebrew's
# python3.11 sitting on PATH — the normal state of a dev laptop — still printed
# "no python >=3.11 found" and checked nothing, on every commit, in every repo.
# The gate was fine; its search was too narrow. A fresh clone has no venv yet,
# which is exactly when someone is most likely to be editing routes.
#
# A fresh `git worktree` is the SAME situation with a different cause: worktrees
# do not share `.venv` (it is gitignored, per-checkout), so `$ROOT/.venv` never
# exists there even though the branch's own commits are fully caught up. The org
# standard is one-worktree-per-branch, so this was not a rare edge case — it was
# the mandated workflow silently disabling the gate on every commit, in every
# worktree, in every repo, and the only visible symptom was a warning line
# scrolling past that nobody reads. A worktree shares its SUPERPROJECT with the
# checkout that created it, and that checkout's venv already has this repo's
# deps installed — so try there before giving up and falling back to a bare
# system interpreter. `--git-common-dir` resolves to the main checkout's `.git`
# for any linked worktree, and to `$ROOT/.git` when there is no worktree at all
# (harmless duplicate candidate, not a bug).
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null)"
MAIN_ROOT=""
if [ -n "$COMMON_DIR" ]; then
  MAIN_ROOT="$(cd "$COMMON_DIR/.." 2>/dev/null && pwd)"
fi

PY=""
PY_FROM_VENV=0
PY_KIND=none
CANDIDATES=("$ROOT/.venv/bin/python" "$ROOT/venv/bin/python")
if [ -n "$MAIN_ROOT" ] && [ "$MAIN_ROOT" != "$ROOT" ]; then
  CANDIDATES+=("$MAIN_ROOT/.venv/bin/python" "$MAIN_ROOT/venv/bin/python")
fi
for c in "${CANDIDATES[@]}"; do
  [ -x "$c" ] || continue
  "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null \
    && { PY="$c"; PY_CMD=("$c"); PY_KIND=venv; PY_FROM_VENV=1; break; }
done

# A REPO THAT DECLARES ITS DEPENDENCIES IS NOT AN UNKNOWN TOOLCHAIN.
#
# The probe above trusts exactly one shape: a venv DIRECTORY someone materialised. A repo
# that declares its dependencies in a requirements file and materialises them on demand
# has an equally known relationship to them -- a stronger one, in fact, because it comes
# from the repo's own pins rather than from whatever was installed by hand and when.
#
# 🔴 MEASURED 2026-08-21, Translation-system: no root venv, deps in
# `backend/requirements.txt`, so this probe fell through to the shell's python3 and
# `scripts/gen_openapi.py` died on `ModuleNotFoundError: No module named 'jwt'`. The leg
# took its fail-OPEN branch, announced SPEC DRIFT NOT CHECKED, and let the commit land.
# The announcement is correct and by design; the consequence is that the spec-drift check
# had never run in that repo. Counted the same day across the local clones, five distinct
# products are in exactly that state -- Translation-system, phrase-monitor,
# schedule-viewer, nexus and redirect-manager -- plus their worktrees and topic clones.
#
# WHY NOT JUST WIDEN THE VENV SEARCH TO SUBDIRECTORIES: it produces the WORSE failure.
# Translation-system does carry a `backend/.venv` and it is STALE -- it cannot import
# apiflask. Trusting it fails CLOSED and blocks a commit whose spec is provably correct;
# regenerating from the declared pins reproduces docs/openapi.json byte for byte. A gate
# that fires on correct code is the gate everyone learns to bypass.
#
# ONE LEVEL DOWN, because that is where these repos actually put it: `backend/` in four of
# the five, `panel/` in proxmox-fleet-manager. Root first, then the shallowest match, so
# the choice is deterministic rather than filesystem-order.
#
# `--no-project` keeps uv from trying to build the repo itself as a package -- most of
# these have no pyproject.toml at all -- and mirrors what the suite legs in these repos
# already run. Warm, it costs ~0.3s; the environment is cached between commits.
if [ -z "$PY" ]; then
  DECLARED_REQS=""

  # A REPO MAY NAME THE FILE ITSELF, AND A NAME BEATS A SEARCH.
  #
  # The search below is a guess -- "the shallowest requirements.txt" -- and a guess is
  # wrong exactly where a repo holds more than one project. 🔴 MEASURED 2026-08-21,
  # google-access-migration: the root requirements.txt describes the `discovery/` tooling
  # (PyJWT, cryptography, requests, PyYAML) while scripts/gen_openapi.py imports the
  # console backend, whose pins live in console/backend/requirements.txt. The search took
  # the root file, uv built an environment that could not import the app, and the leg read
  # `ModuleNotFoundError: No module named 'apscheduler'` as this repo failing to declare a
  # package it declares perfectly well, one directory over.
  #
  # Same discipline as `generator` in the same file (bin/policies/openapi.py,
  # read_declared_generator): someone writes a file name down, the file has to exist, and
  # a declaration resolving to nothing is REPORTED rather than silently ignored -- a
  # declaration nobody can see failing is how a standard quietly dies. Regex-parsed for
  # the same reason: this runs in whatever shell the person happens to have.
  if [ -f "$ROOT/.openapi-policy.toml" ]; then
    GEN_REQS_DECL="$(sed -n "s/^[[:space:]]*generator_requirements[[:space:]]*=[[:space:]]*[\"']\([^\"']*\)[\"'].*/\1/p" \
                     "$ROOT/.openapi-policy.toml" 2>/dev/null | head -1)"
    if [ -n "$GEN_REQS_DECL" ]; then
      if [ -f "$ROOT/$GEN_REQS_DECL" ]; then
        DECLARED_REQS="$ROOT/$GEN_REQS_DECL"
      else
        echo "warning: .openapi-policy.toml declares generator_requirements =" >&2
        echo "         \"$GEN_REQS_DECL\", which is not a file in this repo. Falling back to" >&2
        echo "         the search — fix the declaration or delete it." >&2
      fi
    fi
  fi

  if [ -z "$DECLARED_REQS" ]; then
    for r in "$ROOT/requirements.txt" "$ROOT"/*/requirements.txt; do
      [ -f "$r" ] && { DECLARED_REQS="$r"; break; }
    done
  fi
  if [ -n "$DECLARED_REQS" ] && command -v uv >/dev/null 2>&1; then
    # A repo pinning its own interpreter (`.python-version`) gets it: uv reads that file
    # itself, and overriding it would build an environment the repo never runs.
    if [ -f "$ROOT/.python-version" ]; then
      DECLARED_CMD=(uv run --with-requirements "$DECLARED_REQS" --no-project python)
    else
      DECLARED_CMD=(uv run --python "${CLAUDE_OPENAPI_GATE_PYTHON:-3.12}" \
                    --with-requirements "$DECLARED_REQS" --no-project python)
    fi
    # BUILD IT FIRST, and separately. A resolver that cannot reach an index, or a wheel
    # that will not compile, is a broken toolchain -- NOT a drifted spec -- and the two
    # must not arrive at the same verdict. Only once the environment exists does a
    # generator failure become this repo's problem.
    if DECLARED_ERR="$("${DECLARED_CMD[@]}" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>&1)"; then
      PY_CMD=("${DECLARED_CMD[@]}")
      PY="uv --with-requirements ${DECLARED_REQS#$ROOT/}"
      PY_KIND=declared
      PY_FROM_VENV=1
    else
      echo "warning: SPEC DRIFT NOT CHECKED — uv could not build the environment this repo" >&2
      echo "         declares in ${DECLARED_REQS#$ROOT/}, so the generator has nothing to run in." >&2
      echo "$DECLARED_ERR" | tail -3 >&2
    fi
  fi
fi

if [ -z "$PY" ]; then
  for c in python3.14 python3.13 python3.12 python3.11 python3; do
    command -v "$c" >/dev/null 2>&1 || continue
    "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null \
      && { PY="$c"; PY_CMD=("$c"); PY_KIND=bare; break; }
  done
fi

if [ -f "$ROOT/scripts/gen_openapi.py" ] && [ -f "$ROOT/docs/openapi.json" ]; then
  if [ -z "$PY" ]; then
    # Fail OPEN on the hook's own runtime — a broken toolchain must not be what
    # stops someone committing — but NEVER silently. A gate that says nothing
    # when it checked nothing is indistinguishable from a gate that passed.
    echo "warning: no python >=3.11 found — SPEC DRIFT NOT CHECKED for this commit" >&2
  else
    BEFORE="$(shasum -a 256 "$ROOT/docs/openapi.json" 2>/dev/null | cut -d' ' -f1)"
    SPEC_BACKUP="$(mktemp)"
    cp "$ROOT/docs/openapi.json" "$SPEC_BACKUP" 2>/dev/null || true
    if ! GEN_ERR="$("${PY_CMD[@]}" "$ROOT/scripts/gen_openapi.py" 2>&1)"; then
      if [ "$PY_KIND" = "venv" ]; then
        # This interpreter came from a project venv (this checkout's or the
        # worktree's main checkout) — an environment that is SUPPOSED to have
        # this repo's dependencies installed. If the generator still fails here
        # it is not an unrelated toolchain gap, it is this repo's own venv
        # being stale, and "genuinely cannot verify" is not a reason to let
        # drift through unchecked — that is the exact failure mode this hook
        # exists to close. Refuse, with the actionable fix.
        cat >&2 <<MSG

COMMIT BLOCKED — scripts/gen_openapi.py failed using $PY,
a project venv that is supposed to have this repo's dependencies.

$(echo "$GEN_ERR" | tail -5)

Spec drift could not be verified, and this is not a missing-toolchain case: a
venv was found for this exact repo. Fix THAT venv -- the one named above, which
is the one that failed:
  ${PY%/python}/pip install -r requirements.txt   # or requirements-dev.txt

Do not bypass with --no-verify — that skips this check permanently for this
commit, not just while the venv is stale.$(
  if [ "$PY" != "$MAIN_ROOT/.venv/bin/python" ] && [ "$PY" != "$MAIN_ROOT/venv/bin/python" ] \
     && [ -n "$MAIN_ROOT" ] && [ "$MAIN_ROOT" != "$ROOT" ]; then
    printf '%s' "

NOTE: that venv is INSIDE this worktree ($ROOT), not the main checkout. It is
searched first. A provisioning script that created it and then failed partway --
a private dependency it could not clone, no network -- leaves exactly this: a
python that runs, with the dependencies missing. The main checkout's venv at
$MAIN_ROOT may be perfectly fine and is NOT the one that failed, so installing
there will not clear this. Either finish provisioning the one above, or delete
it so the main checkout's is used:
  rm -rf ${PY%/bin/python}"
  fi
)
MSG
        exit 1
      fi

      # A DECLARED ENVIRONMENT EARNS THE DRIFT COMPARISON, NOT A GENERATOR VERDICT.
      #
      # 🔴 TRIAGED AGAINST GROUND TRUTH 2026-08-21, before this path was allowed to block
      # anything, across the seven repos that reach it. Five regenerated their spec byte
      # for byte -- Translation-system, phrase-monitor, schedule-viewer, redirect-manager,
      # proxmox-fleet-manager-th323. The other TWO failed for reasons that have nothing to
      # do with the contract:
      #
      #   nexus            RuntimeError: Directory '.../backend/app/static/icons' does not
      #                    exist -- a build artefact absent from a clean checkout. The
      #                    environment was fine; it got as far as importing starlette.
      #   gam-gmc-readonly ModuleNotFoundError: apscheduler -- the app imports a package
      #                    its requirements.txt never declares. A real repo defect, and
      #                    still not one this gate is for.
      #
      # Two in seven is a valve tripping on 29% of its candidates, which the org standard
      # names as a defect report about the PREDICATE, never a reason to raise the cap. So
      # the split is by what the failure can actually prove: a venv is a promise somebody
      # made about THIS repo, and a broken one is that promise broken. A declaration is a
      # list of packages; its failure may be a missing directory, an import at module
      # scope, or a genuinely absent dependency -- indistinguishable from here.
      #
      # The win is unchanged and it is the whole point: the drift comparison BELOW now
      # runs in these repos, where it had never run once.
      if [ "$PY_KIND" = "declared" ]; then
        echo "warning: SPEC DRIFT NOT CHECKED — scripts/gen_openapi.py failed in the" >&2
        echo "         environment this repo declares in ${DECLARED_REQS#$ROOT/}." >&2
        echo "$GEN_ERR" | tail -3 >&2
        echo "         Reproduce it:  ${DECLARED_CMD[*]} scripts/gen_openapi.py" >&2
        cp "$SPEC_BACKUP" "$ROOT/docs/openapi.json" 2>/dev/null || true
      fi
      # No project venv was found at all — only a bare system interpreter with
      # no known relationship to this repo's dependencies. That is the genuine
      # broken-toolchain case the original design carved out: fail OPEN, but
      # loudly, same as the "no python found" branch above.
      echo "warning: scripts/gen_openapi.py failed — SPEC DRIFT NOT CHECKED" >&2
      echo "$GEN_ERR" | tail -3 >&2
    else
      AFTER="$(shasum -a 256 "$ROOT/docs/openapi.json" 2>/dev/null | cut -d' ' -f1)"
      if [ "$BEFORE" != "$AFTER" ] && [ "$PY_FROM_VENV" != "1" ]; then
        # A BYTE DIFFERENCE FROM AN UNTRUSTED INTERPRETER IS NOT EVIDENCE OF DRIFT.
        #
        # The spec is not reproducible across framework versions: FastAPI injects its own
        # ValidationError/HTTPValidationError schemas and their shape changes between
        # releases. Measured 2026-08-20 on ONE workstation carrying four of them --
        # /usr/bin/python3 (fastapi 0.116.1), the probe's first pick python3.14 (0.139.0),
        # the shell's python3 (0.141.1), and the repo's own pinned venv (0.115.6, which is
        # what the CT actually installs and runs). Four interpreters, four different
        # docs/openapi.json from identical source, differing only in framework boilerplate.
        #
        # The probe below deliberately does not resolve what a developer's shell resolves, so
        # this branch refused fleet-dns-map's arming commit with the source entirely correct,
        # and its printed remedy -- regenerate and commit -- would have made the NEXT
        # person's gate fire in the other direction. That is the shape of a gate everyone
        # learns to bypass.
        #
        # So: the same carve-out the generator-failure branch above already makes. Only a
        # PROJECT VENV has a known relationship to this repo's declared dependencies; a bare
        # system interpreter does not, and a comparison against one cannot tell drift from a
        # version difference. Fail OPEN, loudly, exactly like the other two branches -- and
        # RESTORE the file, because leaving a spec generated by the wrong FastAPI in the tree
        # is how that wrong spec gets committed.
        cp "$SPEC_BACKUP" "$ROOT/docs/openapi.json" 2>/dev/null || true
        echo "warning: SPEC DRIFT NOT CHECKED — regenerated with $PY, which is not a venv for" >&2
        echo "         this repo, so a byte difference cannot be told from a framework-version" >&2
        echo "         difference. docs/openapi.json was left untouched." >&2
        echo "         To check it: create the repo's venv from its own pins, then re-commit." >&2
      elif [ "$BEFORE" != "$AFTER" ]; then
        cat >&2 <<'MSG'

COMMIT BLOCKED — docs/openapi.json was stale and has just been regenerated.

The routes changed but the committed contract did not. Review the diff (it is the
API change, in reviewable form) and `git add docs/openapi.json`.
MSG
        rm -f "$SPEC_BACKUP"
        exit 1
      fi
      rm -f "$SPEC_BACKUP"
    fi
  fi
fi

# ── the ALERT CONTRACT, on the STAGED files only ─────────────────────────────
#
# 2026-08-11, measured: 1994 root posts and 201 @sysadmin pages in 24h, and 59% of alert
# events never reached the fleet alert relay at all — each one a separate post nothing
# could batch, dedup, page-budget or count. The operator, on why:
#
#   "I wire 1-2 new notifications daily and they break the rules EACH TIME ...
#    we need a hard contract that HAS TO be respected."
#
# The rules already existed. They were documentation, so they lost every time to four
# lines of urlopen. This is the half with teeth — and it is the ONLY half with teeth,
# deliberately: the relay itself accepts everything, always (operator decision 7,
# "we should not decline ones that do not follow it as its missed notifications"), so
# enforcement has to live where it cannot cost a notification at 3am. That is here.
#
# It blocks the BYPASS (a Mattermost alert posted straight at Mattermost) and a
# malformed contract payload. It does NOT block the relay's legacy hook path — 33 repos
# vendor a rail that uses it, decision 6 keeps it working indefinitely, and a gate
# everyone has to bypass is a defect in the gate.
#
# Same fail-OPEN-but-real discipline as every other block here: no guard file, no
# python3, not a git repo -> inert.
AGUARD="$(_policy_bin alert-contract-guard.py)"
if [ -z "$HOME_DIR" ] || [ "$HAVE_PY3" -eq 0 ] || [ ! -f "$AGUARD" ]; then
  guard_unreachable "alert-contract gate" "not found at $AGUARD"
else
  # Same distinction, same reason. This guard reserves 3 for COULD_NOT_RUN, and the
  # shell discarding it meant a guard that never ran and a guard that refused ended the
  # commit identically and silently.
  python3 "$AGUARD" --check "$ROOT"; ALERT_RC=$?
  if [ "$ALERT_RC" -eq 3 ]; then
    echo "" >&2
    echo "COMMIT BLOCKED — the alert-contract guard COULD NOT RUN. It reached no verdict." >&2
    echo "  Nothing above is a finding about this change. Re-run; if it persists the thing" >&2
    echo "  to look at is $AGUARD, not this repo." >&2
    # 125, NOT 1, AND THAT IS THE POINT. The sentence above is for a human; the CODE is
    # for `merge-result.py`, which runs a repo's core.hooksPath pre-commit as its merge
    # gate (GATE_HOOK_NAMES) and reads nothing but the status, where COULD_NOT_RUN = 125.
    # Collapsed to 1, a gate that NEVER ANSWERED is indistinguishable from a branch that
    # genuinely failed: the real red gets retried and the unrunnable guard gets blamed on
    # the change. Still non-zero — nothing about BLOCKING changes, and a gate that cannot
    # RUN is still not permission to skip it.
    exit 125
  elif [ "$ALERT_RC" -ne 0 ]; then
    exit 1
  fi
fi

# ── the GATE-OFFLOAD standard: a gate runs its suite on the RUNNER ───────────
#
# `CLAUDE.md` has said "GATE SUITES RUN ON THE RUNNER, NOT THE WORKSTATION" for weeks,
