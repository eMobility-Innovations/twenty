# It refuses `over the ceiling AND this commit made the file LONGER`, never the ceiling
# alone. The absolute form was rejected on this file's own valve rule: 120 passes ~85% of
# repos on day one, so refusing every commit in the remainder — including a one-line
# bugfix that never touched the agent file — is precisely the gate everybody learns to
# pass with --no-verify. Shrinking an over-budget file is ALWAYS allowed, even while it
# is still over; a NEW agent file may not be born over the ceiling; a third-party repo is
# reported and never refused.
#
# Draining the repos ALREADY over the line is `bin/claude-md-estate-sweep.py`, which
# measures every org repo from GitHub. This gate stops the bleeding; the sweep drains it.
#
# Same fail-OPEN-but-LOUD discipline as every other block here.
MD_GUARD="$(_policy_bin claude-md-repo-guard.py)"
if [ -z "$HOME_DIR" ] || [ "$HAVE_PY3" -eq 0 ] || [ ! -f "$MD_GUARD" ]; then
